# Frontend (Netlify / Vite) — optional; the API can supply the public key
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
# Optional. Leave unset so the site uses /api (Vite locally, Netlify proxy in production).
# VITE_API_URL=https://mbatfoundation.onrender.com

# Backend (Render web service) — both keys must be test or both live
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mbat?retryWrites=true&w=majority
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
CORS_ORIGIN=https://your-site.netlify.app,http://localhost:5173

# Paystack webhook (set in Paystack dashboard):
# https://mbatfoundation.onrender.com/paystack-webhook
